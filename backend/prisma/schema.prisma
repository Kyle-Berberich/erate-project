// This is your Prisma schema file

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  ADMIN
  MANAGER
  CONTRIBUTOR
  VIEWER
}

enum ApplicationCategory {
  CATEGORY_ONE
  CATEGORY_TWO
}

enum ApplicationStatus {
  DRAFT
  SUBMITTED
  UNDER_REVIEW
  APPROVED
  COMMITTED
  IN_PROGRESS
  COMPLETED
  DENIED
  CANCELLED
}

enum ComplianceDocType {
  FORM_470
  FORM_471
  CONTRACT
  INVOICE
  BEAR_FORM
  PIA_REPORT
  SITE_VISIT
  OTHER
}

enum ComplianceStatus {
  PENDING
  RECEIVED
  APPROVED
  REJECTED
  OVERDUE
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  ON_HOLD
  COMPLETED
  CANCELLED
}

enum MilestoneStatus {
  NOT_STARTED
  IN_PROGRESS
  COMPLETED
  OVERDUE
}

enum ChecklistStatus {
  TODO
  IN_PROGRESS
  DONE
}

enum FileOwnerType {
  COMPLIANCE
  PROJECT
  APPLICATION
  REPORT
}

enum ReportType {
  MONTHLY_SUMMARY
  APPLICATION_STATUS
  VENDOR_PERFORMANCE
  COMPLIANCE_CHECKLIST
}

enum NotificationKind {
  DEADLINE_REMINDER
  OVERDUE_ALERT
  MILESTONE_DUE
  DIGEST_DAILY
  DIGEST_WEEKLY
}

enum AuditAction {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGOUT
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String   @map("password_hash")
  role          UserRole @default(VIEWER)
  mfaSecret     String?  @map("mfa_secret")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  projectsOwned       Project[]           @relation("ProjectOwner")
  milestonesAssigned  ProjectMilestone[]  @relation("MilestoneAssignee")
  checklistsAssigned  ChecklistItem[]     @relation("ChecklistAssignee")
  filesUploaded       File[]              @relation("FileUploader")
  auditLogs           AuditLog[]
  notifications       Notification[]

  @@map("users")
}

model Vendor {
  id            String   @id @default(cuid())
  name          String
  rating        Int?     // 1-5 scale
  contractValue Decimal  @default(0) @map("contract_value") @db.Decimal(15, 2)
  contact       String?
  notes         String?  @db.Text
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Relations
  applications Application[]

  @@map("vendors")
}

model Application {
  id                String              @id @default(cuid())
  frn               String              @unique // Funding Request Number
  name              String
  vendorId          String              @map("vendor_id")
  category          ApplicationCategory
  serviceType       String              @map("service_type")
  status            ApplicationStatus   @default(DRAFT)
  amountRequested   Decimal             @default(0) @map("amount_requested") @db.Decimal(15, 2)
  amountCommitted   Decimal             @default(0) @map("amount_committed") @db.Decimal(15, 2)
  amountDisbursed   Decimal             @default(0) @map("amount_disbursed") @db.Decimal(15, 2)
  discountRate      Decimal             @default(0) @map("discount_rate") @db.Decimal(5, 2) // Percentage
  serviceStart      DateTime?           @map("service_start")
  serviceEnd        DateTime?           @map("service_end")
  applicationDate   DateTime?           @map("application_date")
  approvalDate      DateTime?           @map("approval_date")
  notes             String?             @db.Text
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  // Relations
  vendor           Vendor              @relation(fields: [vendorId], references: [id], onDelete: Cascade)
  complianceDocs   ComplianceDoc[]
  files            File[]

  @@map("applications")
}

model ComplianceDoc {
  id              String            @id @default(cuid())
  applicationId   String            @map("application_id")
  docType         ComplianceDocType @map("doc_type")
  dateRequired    DateTime?         @map("date_required")
  dateReceived    DateTime?         @map("date_received")
  status          ComplianceStatus  @default(PENDING)
  retentionYears  Int               @default(5) @map("retention_years")
  disposalDate    DateTime?         @map("disposal_date") // Auto-calculated
  storageUri      String?           @map("storage_uri")
  reviewer        String?
  notes           String?           @db.Text
  createdAt       DateTime          @default(now()) @map("created_at")
  updatedAt       DateTime          @updatedAt @map("updated_at")

  // Relations
  application Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  files       File[]

  @@map("compliance_docs")
}

model Project {
  id          String        @id @default(cuid())
  name        String
  type        String
  ownerId     String        @map("owner_id")
  startDate   DateTime?     @map("start_date")
  endDate     DateTime?     @map("end_date")
  status      ProjectStatus @default(PLANNING)
  notes       String?       @db.Text
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Relations
  owner          User               @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  milestones     ProjectMilestone[]
  checklistItems ChecklistItem[]
  files          File[]

  @@map("projects")
}

model ProjectMilestone {
  id         String          @id @default(cuid())
  projectId  String          @map("project_id")
  title      String
  dueDate    DateTime?       @map("due_date")
  status     MilestoneStatus @default(NOT_STARTED)
  assigneeId String?         @map("assignee_id")
  notes      String?         @db.Text
  createdAt  DateTime        @default(now()) @map("created_at")
  updatedAt  DateTime        @updatedAt @map("updated_at")

  // Relations
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("MilestoneAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@map("project_milestones")
}

model ChecklistItem {
  id          String          @id @default(cuid())
  projectId   String          @map("project_id")
  description String
  dueDate     DateTime?       @map("due_date")
  status      ChecklistStatus @default(TODO)
  assigneeId  String?         @map("assignee_id")
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")

  // Relations
  project  Project @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User?   @relation("ChecklistAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)

  @@map("checklist_items")
}

model File {
  id          String        @id @default(cuid())
  ownerType   FileOwnerType @map("owner_type")
  ownerId     String        @map("owner_id")
  filename    String
  mime        String
  sizeBytes   Int           @map("size_bytes")
  storageUri  String        @map("storage_uri")
  uploadedBy  String        @map("uploaded_by")
  uploadedAt  DateTime      @default(now()) @map("uploaded_at")
  metadata    Json?         @db.JsonB

  // Relations
  uploader      User           @relation("FileUploader", fields: [uploadedBy], references: [id], onDelete: Cascade)
  application   Application?   @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  complianceDoc ComplianceDoc? @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  project       Project?       @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@map("files")
}

model Report {
  id          String     @id @default(cuid())
  type        ReportType
  periodStart DateTime?  @map("period_start")
  periodEnd   DateTime?  @map("period_end")
  storageUri  String?    @map("storage_uri")
  createdAt   DateTime   @default(now()) @map("created_at")

  @@map("reports")
}

model AuditLog {
  id       String      @id @default(cuid())
  userId   String?     @map("user_id")
  entity   String
  entityId String?     @map("entity_id")
  action   AuditAction
  before   Json?       @db.JsonB
  after    Json?       @db.JsonB
  at       DateTime    @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model Setting {
  id    String @id @default(cuid())
  key   String @unique
  value Json   @db.JsonB

  @@map("settings")
}

model Notification {
  id           String           @id @default(cuid())
  userId       String           @map("user_id")
  kind         NotificationKind
  scheduledFor DateTime         @map("scheduled_for")
  sentAt       DateTime?        @map("sent_at")
  payload      Json             @db.JsonB

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}
